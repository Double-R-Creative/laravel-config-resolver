{
    "name": "drc/laravel-config-resolver",
    "description": "Fluent configuration validation and class resolution for Laravel packages.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "keywords": [
        "laravel",
        "config",
        "resolver",
        "validation",
        "eloquent"
    ],
    "authors": [
        {
            "name": "Russell Ramey",
            "email": "doublercreative@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "DRC\\ConfigResolver\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "format": [
            "@php vendor/bin/pint"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Vendor\\ConfigResolver\\ConfigResolverServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
